% =============================================================================
%  Plantilla Pandoc → LuaLaTeX del Programa General del FIMNME
%  Coordinación Nacional de Música y Ópera
%
%  Se usa junto con el filtro automatizacion/fimnme.lua, que convierte la
%  estructura del Markdown (conciertos, programa, fichas, notas...) en las
%  macros definidas aquí. Compílese con ./compila.sh
% =============================================================================
\DocumentMetadata{lang=es-MX, pdfversion=1.7}
\documentclass[
  fontsize=9.5pt,
  oneside,
  parskip=false,
  headings=small,
  numbers=noenddot,
  open=any,
  toc=flat
]{scrbook}

% ---------------------------------------------------------------- Página -----
% Formato vertical 9:16 pensado para leerse en el teléfono.
\usepackage[
  paperwidth=108mm, paperheight=192mm,
  top=14mm, bottom=10.5mm, left=10mm, right=10mm,
  headheight=13pt, headsep=4.5mm, footskip=6mm
]{geometry}

% ----------------------------------------------------------- Tipografía ------
\usepackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\newcommand{\rutafuentes}{automatizacion/fuentes/}
\setmainfont{NotoSans}[
  Path=\rutafuentes, Extension=.ttf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-Bold, BoldItalicFont=*-BoldItalic,
  FontFace={sb}{n}{*-SemiBold}, FontFace={sb}{it}{*-SemiBoldItalic},
  FontFace={l}{n}{*-Light}, FontFace={l}{it}{*-LightItalic},
  FontFace={eb}{n}{*-ExtraBold},
  Numbers=Lining
]
% Las negritas del texto usan el peso seminegro (más fino que el Bold).
\renewcommand{\bfdefault}{sb}
\newfontfamily\fuentecifras{NotoSans}[
  Path=\rutafuentes, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-SemiBold, Numbers={Lining,Monospaced}]
\AtBeginDocument{\renewcommand{\bfdefault}{sb}}
% Caracteres chinos (p. ej. el título 樗栎 de Daniel Cui); el filtro los envuelve.
\IfFontExistsTF{Noto Sans CJK SC}
  {\newfontfamily\fuentecjk{Noto Sans CJK SC}[
     BoldFont={Noto Sans CJK SC Bold}, FontFace={sb}{n}{Noto Sans CJK SC Bold}]
   % sin cursiva: el texto chino se compone siempre en redonda
   \newcommand{\textocjk}[1]{{\fontshape{n}\fuentecjk #1}}}
  {\newcommand{\textocjk}[1]{#1}}
\newcommand{\ligera}{\fontseries{l}\selectfont}
\newcommand{\negrita}{\fontseries{b}\selectfont}
\newcommand{\extranegrita}{\fontseries{eb}\selectfont}

\usepackage[spanish, es-nodecimaldot, es-noquoting, es-noshorthands, es-nolayout]{babel}
\usepackage[protrusion=true, expansion=true, tracking=true, final]{microtype}
\SetTracking{encoding=*, shape=sc}{60}
\newcommand{\espaciado}[2][80]{\textls[#1]{#2}}

\linespread{1.12}% (véase también \interlineado)
\setparsizes{0pt}{0.55\baselineskip plus 1pt minus 0.5pt}{0pt plus 1fil}
\raggedbottom
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=5000
\emergencystretch=1.2em
\hyphenpenalty=200
\setlength{\overfullrule}{0pt}

% ---------------------------------------------------------------- Color ------
\usepackage[table]{xcolor}
% Color por atributos de LuaTeX: \color no inserta nodos en la lista vertical,
% así que no crea puntos de corte de página indeseados (leyendas huérfanas...).
\usepackage{luacolor}
\definecolor{verdeoscuro}{HTML}{172B20}
\definecolor{acento}{HTML}{2F7F59}
\definecolor{acentoclaro}{HTML}{3D9B6E}
\definecolor{verdeclaro}{HTML}{D2E8DB}
\definecolor{verdegris}{HTML}{546B5C}
\definecolor{filete}{HTML}{B9CDBF}
\definecolor{fondobeige}{HTML}{F4F1EA}
\definecolor{fondocita}{HTML}{EAE8DF}
\definecolor{portadabase}{HTML}{4E5F44}
\definecolor{portadaluz}{HTML}{768F68}
\definecolor{portadatexto}{HTML}{E2E6DF}
\definecolor{portadalogo}{HTML}{C7D2C3}
\definecolor{portadacaja}{HTML}{A5B9A8}
\pagecolor{fondobeige}
\AtBeginDocument{\color{verdeoscuro}}

% ------------------------------------------------------------ Utilidades -----
\usepackage{graphicx}
\usepackage{tikz}
\usetikzlibrary{calc,fadings,positioning}
% Salta de página solo si no cabe la altura pedida. (needspace.sty mete una
% penalización negativa que, con \raggedbottom, provoca cortes prematuros.)
% Si la página ya está desbordada (pagetotal > pagegoal) el corte natural
% llegará solo; forzarlo dejaría unas líneas sueltas en una página aparte.
\newcommand{\necesito}[1]{\par
  \ifdim\pagetotal>0pt
    \ifdim\pagetotal<\pagegoal
      \ifdim\dimexpr\pagegoal-\pagetotal\relax<\dimexpr#1\relax\newpage\fi
    \fi
  \fi}
\usepackage{truncate}
\usepackage{enumitem}
\setlist{nosep}
\usepackage[most]{tcolorbox}
\usepackage{etoolbox}
\usepackage{xurl}
\usepackage{makeidx}
\makeindex

\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\pandocbounded}[1]{#1}

\input{automatizacion/plantilla/logo-48.tex}
\input{automatizacion/plantilla/logo-cnmo.tex}
\newcommand{\partitura}{automatizacion/plantilla/partitura-1x4.pdf}

% ---------------------------------------------------------- Cabeceras --------
\usepackage[headsepline=false, footsepline=false]{scrlayer-scrpage}
\clearpairofpagestyles
\newcommand{\cabeceraizq}{}
\ihead{\truncate{\dimexpr\textwidth-3.5em\relax}{\cabeceraizq}}
\ohead{\pagemark}
\setkomafont{pagehead}{\normalfont\footnotesize\color{verdegris}}
\setkomafont{pagenumber}{\normalfont\footnotesize\bfseries\color{acento}}
\newcommand{\fijarcabecera}[1]{\gdef\cabeceraizq{#1}}
\pagestyle{scrheadings}

% ----------------------------------------------------------- Hiperenlaces ----
\usepackage[
  pdfusetitle, bookmarks=true, bookmarksnumbered=false, bookmarksopen=true,
  bookmarksopenlevel=0, colorlinks=true, linkcolor=verdeoscuro, urlcolor=acento,
  pdfpagelabels=true, pdfdisplaydoctitle=true, hyperindex=true, linktoc=all,
  unicode=true
]{hyperref}
\hypersetup{
  pdftitle={$pdftitle$},
  pdfauthor={$for(author)$$author$$sep$; $endfor$},
  pdfsubject={$subtitle$},
  pdfkeywords={FIMNME; música nueva; Manuel Enríquez; programa; 2026},
  pdfcreator={Pandoc, Lua y LuaLaTeX}
}
\usepackage{bookmark}
\makeatletter
\newcommand{\marcador}[2]{\phantomsection\bookmark[level=#1, dest=\@currentHref]{#2}}
\makeatother

% ======================================================================
%  Ajuste fino de páginas (dos pasadas): véase automatizacion/plantilla/ajuste.lua
% ======================================================================
\directlua{dofile("automatizacion/plantilla/ajuste.lua")}
\makeatletter
\AtBeginDocument{\let\fimnmeaux\@auxout}
\newcommand{\fimnmepos}[3]{\directlua{fimnme.guardapos("#1", #2, #3)}}
\newcommand{\fimnmeajuste}[2]{\directlua{fimnme.guardaajuste("#1", #2)}}
\newcommand{\marcapos}[1]{\savepos\write\@auxout{\string\fimnmepos{#1}{\the\c@page}{\the\lastypos}}}
\makeatother
\newcommand{\interlineado}{1.12}
\def\modoprograma{0}
\def\modobiografias{0}
\newcommand{\iniconcierto}[1]{%
  \marcapos{ini:#1}\directlua{fimnme.iniconcierto(#1)}%
  \linespread{\interlineado}\selectfont}
\newcommand{\finprograma}[1]{\par\marcapos{finprog:#1}}
% Secciones de semblanzas y notas (Personas compositoras, Intérpretes...)
\newcommand{\iniseccion}[1]{%
  \marcapos{ini:#1}\directlua{fimnme.iniseccion("#1")}\aplicamodobiografias}
\newcommand{\finseccion}[1]{\par\marcapos{fin:#1}}
\newcommand{\aplicamodobiografias}{%
  \ifcase\modobiografias\relax
    \linespread{\interlineado}\or\linespread{1.055}\or\linespread{1.0}\or
    \linespread{1.18}\or\linespread{1.24}\fi
  \selectfont}

% ======================================================================
%  Portada y contraportada (vectoriales)
% ======================================================================
\newcommand{\fondopartitura}[1][0.13]{%
  \fill[portadabase] (current page.south west) rectangle (current page.north east);
  \begin{scope}
    \clip (current page.south west) rectangle (current page.north east);
    \shade[inner color=portadaluz, outer color=portadabase]
      ($$(current page.north east)+(-10mm,-6mm)$$) circle (125mm);
    \node[anchor=north east, inner sep=0pt, opacity=#1]
      at ($$(current page.north east)+(52mm,0mm)$$)
      {\includegraphics[height=\paperheight]{\partitura}};
  \end{scope}%
}

\newcommand{\portada}{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fondopartitura
    % Logotipo y nombre del Foro
    \node[anchor=north west, inner sep=0pt] (logo)
      at ($$(current page.north west)+(11.5mm,-17mm)$$) {\logofimnme{23mm}{portadalogo}};
    \node[anchor=north west, inner sep=0pt, text=portadatexto]
      (titulo) at ($$(logo.north east)+(3.2mm,0.4mm)$$) {%
      \renewcommand{\arraystretch}{1}\setlength{\tabcolsep}{0pt}%
      \begin{tabular}{l}
        \fontsize{12.6}{13.6}\ligera FORO INTERNACIONAL\\
        \fontsize{12.6}{13.6}\ligera DE MÚSICA NUEVA\\
        \fontsize{12.6}{14.4}\fontseries{sb}\selectfont MANUEL ENRÍQUEZ\\[0.9mm]
        \fontsize{8.6}{10}\negrita NOVIEMBRE 6 AL 21, 2026
      \end{tabular}};
    % Programa general
    \node[fill=portadacaja, text=verdeoscuro, minimum width=58mm, minimum height=6.2mm,
      inner sep=0pt, font=\fontsize{9.4}{10}\negrita]
      (programa) at ($$(current page.center)+(0,9mm)$$) {\espaciado[40]{PROGRAMA GENERAL}};
    \node[below=4.2mm of programa, text=portadatexto, inner sep=0pt]
      (contenido) {%
      \renewcommand{\arraystretch}{1}\setlength{\tabcolsep}{0pt}%
      \begin{tabular}{c}
        \fontsize{9.6}{12.4}\negrita CONCIERTOS\\
        \fontsize{9.6}{12.4}\selectfont ACTIVIDADES ACADÉMICAS\\
        \fontsize{9.6}{12.4}\negrita COLOQUIO ENRÍQUEZ\,|\,100
      \end{tabular}};
    \node[below=4.2mm of contenido, align=center, text=portadatexto, inner sep=0pt,
      text width=84mm, font=\fontsize{5.2}{7.4}\bfseries]
      {\hyphenpenalty=10000 $for(estados-portada)$\mbox{\espaciado[30]{$estados-portada$}}$sep$ \,·\, $endfor$\par};
    % Coordinación Nacional de Música y Ópera
    \node[anchor=south, inner sep=0pt] at ($$(current page.south)+(0,19mm)$$)
      {\logocnmo{17mm}{white}};
  \end{tikzpicture}%
  \null\clearpage
}

% Contraportada: directorio de la Secretaría de Cultura y del INBAL (del
% bloque «::: contraportada» del Markdown) y la pleca institucional al pie.
\newsavebox{\cajadirectorio}
\newenvironment{directoriocontraportada}{%
  \global\setbox\cajadirectorio=\vbox\bgroup\hsize=84mm\parindent=0pt
  \estilotitulos\centering\fontsize{7.6}{9.3}\selectfont\color{portadatexto}%
  \let\\\saltocredito\setlength{\parskip}{2mm}\hyphenpenalty=10000}
  {\par\egroup}
\newcommand{\grupodirectorio}[1]{\par\addvspace{4.5mm}%
  {\fontsize{7}{8.6}\bfseries\color{portadacaja}\espaciado[80]{\MakeUppercase{#1}}\par}%
  \nopagebreak\vspace{0.4mm}}
\newcommand{\pleca}{automatizacion/plantilla/pleca-cultura-inbal.pdf}
\newcommand{\contraportada}{%
  \clearpage\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fondopartitura[0.10]
    \node[anchor=north, inner sep=0pt] at ($$(current page.north)+(0,-20mm)$$)
      {\logofimnme{10mm}{portadalogo}};
    \ifvoid\cajadirectorio\else
      \node[inner sep=0pt] at ($$(current page.center)+(0,4mm)$$) {\usebox{\cajadirectorio}};
    \fi
    \node[anchor=south, inner sep=0pt] (pleca) at (current page.south)
      {\includegraphics[width=\paperwidth]{\pleca}};
    \node[anchor=south, inner sep=0pt] at ($$(pleca.north)+(0,7mm)$$)
      {\logocnmo{8mm}{white}};
  \end{tikzpicture}%
  \null
}

% ======================================================================
%  Páginas divisorias
% ======================================================================
% Partes: CONCIERTOS EN CIUDAD DE MÉXICO, CONCIERTOS EN LOS ESTADOS...
\newcommand{\parte}[3]{% #1 título (con formato)  #2 texto para índice/marcador  #3 subtítulo
  \clearpage\thispagestyle{empty}%
  \phantomsection\addcontentsline{toc}{parte}{#2}\marcador{0}{#2}%
  \begin{tikzpicture}[remember picture, overlay]
    \fondopartitura[0.09]
    \node[anchor=north west, inner sep=0pt] at ($$(current page.north west)+(10mm,-16mm)$$)
      {\logofimnme{10mm}{portadalogo}};
    \node[anchor=south west, text width=86mm, align=left, inner sep=0pt, text=portadatexto,
      font=\fontsize{20}{23.5}\negrita]
      (t) at ($$(current page.south west)+(10mm,48mm)$$) {\estilotitulos\hbadness=10000 #1\par};
    \draw[portadacaja, line width=1.2pt] ($$(t.north west)+(0,5mm)$$) -- ++(14mm,0);
    \ifblank{#3}{}{%
      \node[anchor=north west, text width=86mm, align=left, inner sep=0pt, text=portadacaja,
        font=\small\itshape] at ($$(t.south west)+(0,-4mm)$$) {\estilotitulos #3\par};}
  \end{tikzpicture}%
  \null\clearpage
  \fijarcabecera{}%
}

% Días
\newcommand{\divisordia}[4]{% #1 día de la semana  #2 número  #3 mes  #4 texto para el índice
  \clearpage\thispagestyle{empty}%
  \ifblank{#4}{}{\phantomsection\addcontentsline{toc}{dia}{#4}}%
  \marcador{1}{#1 #2 de #3}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[verdeclaro] (current page.south west) rectangle (current page.north east);
    \node[anchor=south west, inner sep=0pt, text=acento, align=left]
      (dia) at ($$(current page.south west)+(10mm,58mm)$$)
      {\fontsize{15}{18}\bfseries\espaciado[60]{\MakeUppercase{#1}}};
    \node[anchor=north west, inner sep=0pt, text=verdeoscuro]
      (num) at ($$(dia.south west)+(-1.4mm,-1mm)$$)
      {\fontsize{92}{92}\extranegrita #2};
    \node[anchor=north west, inner sep=0pt, text=verdeoscuro]
      at ($$(num.south west)+(1.4mm,-2mm)$$)
      {\fontsize{15}{18}\ligera\espaciado[60]{\MakeUppercase{#3} 2026}};
    \draw[acento, line width=1.2pt] ($$(dia.north west)+(0,5mm)$$) -- ++(14mm,0);
  \end{tikzpicture}%
  \null\clearpage
}

% Divisoria genérica (Coloquio, Sedes, Directorio...)
\newcommand{\divisor}[1]{%
  \clearpage\thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[verdeclaro] (current page.south west) rectangle (current page.north east);
    \node[anchor=south west, text width=86mm, align=left, inner sep=0pt, text=verdeoscuro,
      font=\fontsize{20}{24}\negrita]
      (t) at ($$(current page.south west)+(10mm,58mm)$$) {\estilotitulos\hbadness=10000 #1\par};
    \draw[acento, line width=1.2pt] ($$(t.north west)+(0,5mm)$$) -- ++(14mm,0);
  \end{tikzpicture}%
  \null\clearpage
}

% ======================================================================
%  Conciertos
% ======================================================================
\newcommand{\estilotitulos}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000}

% #1 fecha y hora (VIE | NOV 6, 20:00 h)  #2 título  #3 texto de cabecera
% #4 hora para el índice  #5 título para índice  #6 texto para marcador
\newcommand{\concierto}[6]{%
  \clearpage
  \encabezadoconcierto{#1}{#2}{#3}{#4}{#5}{#6}%
}
% Actividades académicas: entradas breves, sin salto de página
% Bloque de una actividad académica: no se parte entre páginas (si no cabe,
% pasa entera a la siguiente). Se compone primero en una caja y se mide; la
% cabecera de página cambia solo cuando la caja ya está en su página.
\makeatletter
\newsavebox{\cajaactividad}
\newenvironment{actividadentera}{\par\addvspace{6mm}%
  \begin{lrbox}{\cajaactividad}\begin{minipage}[t]{\linewidth}\let\necesito\@gobble
  \def\fijarcabecera##1{\gdef\cabecerapendiente{##1}}%
  \hyphenpenalty=10000 % sin dividir palabras (nombres de personas)
  \raggedright % listas de nombres: sin justificar (no quedan huecos grandes)
  \setparsizes{0pt}{0.55\baselineskip plus 1pt minus 0.5pt}{0pt plus 1fil}}
  {\par\end{minipage}\end{lrbox}%
  \necesito{\dimexpr\ht\cajaactividad+\dp\cajaactividad+6mm\relax}%
  \ifdefined\cabecerapendiente\global\let\cabeceraizq\cabecerapendiente\fi
  \noindent\usebox{\cajaactividad}\par\addvspace{2mm}}
\makeatother
\newcommand{\actividadacademica}[6]{%
  \par\necesito{14\baselineskip}\addvspace{6mm}%
  \encabezadoconcierto{#1}{#2}{#3}{#4}{#5}{#6}%
}
\newcommand{\encabezadoconcierto}[6]{%
  \fijarcabecera{#3}%
  \phantomsection\addcontentsline{toc}{concierto}{\protect\numberline{#4}#5}%
  \marcador{2}{#6}%
  \begingroup\estilotitulos
  {\fontsize{7.8}{9.4}\bfseries\color{acento}\espaciado[40]{#1}\par}%
  \vspace{0.5mm}%
  {\fontsize{12}{14.4}\negrita\color{verdeoscuro}#2\par}%
  \endgroup
  \nopagebreak\vspace{0.8mm}%
}
\newcommand{\lugar}[1]{%
  {\estilotitulos\footnotesize\color{verdegris}#1\par}\nopagebreak
  \vspace{1mm}{\color{filete}\rule{\linewidth}{0.6pt}}\par\vspace{0.2mm}%
}
% Sección genérica de nivel concierto (Coloquio, Sedes, Directorio...)
\newcommand{\seccionmayor}[3]{% #1 título  #2 cabecera  #3 marcador/índice
  \clearpage
  \fijarcabecera{#2}%
  \phantomsection\addcontentsline{toc}{seccionmayor}{#3}\marcador{1}{#3}%
  {\estilotitulos\fontsize{15.5}{18.5}\negrita\color{verdeoscuro}#1\par}%
  \nopagebreak\vspace{1.2mm}{\color{filete}\rule{\linewidth}{0.6pt}}\par\vspace{1mm}%
}

% Secciones dentro del concierto: Programa, Personas compositoras, Intérpretes...
\newcommand{\seccion}[2]{% #1 título  #2 nivel de marcador
  \par\necesito{7\baselineskip}\addvspace{2.6mm}%
  \marcador{#2}{#1}%
  {\estilotitulos\fontsize{8.2}{10}\bfseries\color{acento}%
   \rule[-0.5mm]{2.2pt}{3.2mm}\hspace{1.8mm}\espaciado[70]{\MakeUppercase{#1}}\par}%
  \nopagebreak\vspace{0.8mm}%
}
\newcommand{\separador}{%
  \par\addvspace{1.5mm}\noindent{\color{filete}\rule{\linewidth}{0.5pt}}\par\addvspace{1mm}}

% ------------------------------------------------------------ Programa -------
\newlength{\anchoduracion}\setlength{\anchoduracion}{2.6em}
\newlength{\anchoespaciocompositor}\setlength{\anchoespaciocompositor}{1.1mm}
\newcommand{\compositor}[2]{% #1 nombre  #2 resto (país, años...)
  \par\necesito{3.2\baselineskip}\addvspace{\anchoespaciocompositor}%
  {\estilotitulos\bfseries #1\mdseries #2\par}\nopagebreak[4]%
}
\newenvironment{obras}{%
  \begin{list}{\textcolor{acentoclaro}{\rule[0.32ex]{0.42em}{0.42em}}}{%
    \setlength{\leftmargin}{1.05em}\setlength{\labelwidth}{0.6em}%
    \setlength{\labelsep}{0.45em}\setlength{\rightmargin}{\anchoduracion}%
    \setlength{\itemsep}{0.15mm}\setlength{\topsep}{0.2mm}\setlength{\parsep}{0pt}%
    \setlength{\partopsep}{0pt}\estilotitulos}}
  {\end{list}}
\newcommand{\duracion}[1]{{\fuentecifras\bfseries\color{acento}#1}}
% #1 título  #2 duración  #3 créditos (video, imágenes...)
\newcommand{\obra}[3]{%
  \item\leavevmode\ifblank{#2}{}{\rlap{\hspace*{\linewidth}\hspace*{\anchoduracion}\llap{\duracion{#2}}}}%
  #1\ifblank{#3}{}{\par{\footnotesize\color{verdegris}#3\par}}}
\newcommand{\movimiento}[1]{%
  \item[]\hspace*{0.9em}{\small\color{verdegris}#1}}
% Aire entre los movimientos de una obra y la obra siguiente
\newcommand{\trasmovimientos}{\par\addvspace{1.6mm}}
% Si el programa no cabe en una página ni compactado (modo 3), la segunda
% parte empieza en la página siguiente: así no queda una obra suelta.
\newcommand{\intermedio}{%
  \par\ifnum\modoprograma=3 \newpage\fi\addvspace{2mm}%
  \noindent{\color{filete}\leaders\hrule height 0.5pt depth 0pt\hfill}%
  \enspace{\footnotesize\bfseries\color{verdegris}\espaciado[120]{INTERMEDIO}}\enspace
  {\color{filete}\leaders\hrule height 0.5pt depth 0pt\hfill}\par\addvspace{1.2mm}}
\newcommand{\leyenda}[1]{%
  \par\removelastskip\nopagebreak[4]\vspace{0.75\baselineskip}\nopagebreak[4]%
  {\footnotesize\color{verdegris}#1\par}}
% Intérpretes de un grupo de obras: filete a la izquierda, un punto menos.
% El bloque no se parte entre páginas.
\newenvironment{interpretes}{%
  \par\addvspace{3.6mm}%
  \begin{tcolorbox}[enhanced, frame hidden, boxrule=0pt, sharp corners,
    colback=fondobeige, borderline west={1.3pt}{0pt}{acentoclaro},
    enlarge left by=0.33em, width=\linewidth-0.33em,
    left=0.6em, right=0mm, top=0.5mm, bottom=0.5mm, boxsep=0pt,
    before skip=0pt, after skip=0pt, fontupper=\small, parbox=false]
  \setlength{\parskip}{0.8mm}\estilotitulos}
  {\end{tcolorbox}\par}
% Separación entre grupos de obras con distintos intérpretes
% (se estira si en la página sobra espacio: los grupos se reparten en ella)
\newcommand{\separadorgrupo}{\par\addvspace{6.5mm plus 1fil}}
% Al empezar un grupo: si no cabe entero en lo que queda de página, pasa a
% la siguiente (el filtro estima su altura en renglones).
\newcommand{\inigrupo}[1]{\necesito{#1\baselineskip}}
% Grupos con distintos intérpretes: si en la pasada anterior un grupo quedó
% solo en su página, sus intérpretes van al pie, como en los programas de un
% solo grupo (#1 concierto, #2 grupo, #3 ¿último?, #4 leyenda de estrenos).
\def\fondogrupo{0}
\newcommand{\grupoini}[2]{\def\fondogrupo{0}\marcapos{gi:#1-#2}\nobreak}
\newcommand{\grupofin}[2]{\par\marcapos{gf:#1-#2}}
\newcommand{\grupoint}[4]{\par\directlua{fimnme.grupofondo(#1, #2, #3)}%
  \ifnum\fondogrupo=1 #4\par\vspace*{\fill}\fi}
\newcommand{\leyendagrupos}[1]{\ifnum\fondogrupo=0 \leyendafinal{#1}\fi}
% Leyenda de estrenos al final de un programa con varios grupos
\newcommand{\leyendafinal}[1]{%
  \par\nopagebreak[4]\vspace{4mm}%
  {\footnotesize\color{verdegris}#1\par}}
% Solista de una obra concreta (crédito bajo la obra, dentro del grupo)
\newcommand{\solista}[1]{%
  \par\nopagebreak\vspace{0.6mm}%
  {\estilotitulos\small\leftskip=1.05em\color{verdeoscuro}#1\par}\nopagebreak[3]}
% Nota breve dentro del programa (duración, patrocinio...)
\newcommand{\notaprograma}[1]{%
  \par\addvspace{0.8mm}{\estilotitulos\small\itshape\color{verdegris}#1\par}}
% Leyenda de estrenos como último renglón de la lista de obras
\makeatletter
\newcommand{\leyendaobras}[1]{%
  \par\nopagebreak[4]\vspace{0.75\baselineskip}\nopagebreak[4]%
  \@itempenalty=\@M
  \item[]\hspace*{-\leftmargin}{\footnotesize\color{verdegris}#1}}
\makeatother
\newenvironment{bloqueprograma}{\par\estilotitulos
  \ifnum\modoprograma=1
    \linespread{1.0}\selectfont\setlength{\anchoespaciocompositor}{0.4mm}%
    \setlength{\parskip}{0.12\baselineskip plus 1pt}%
  \else\ifnum\modoprograma=2
    \linespread{0.95}\selectfont\setlength{\anchoespaciocompositor}{0pt}%
    \setlength{\parskip}{0pt plus 1pt}%
    \renewcommand{\separadorgrupo}{\par\addvspace{2mm plus 1fil}}%
  \else
    \setlength{\parskip}{0.3\baselineskip plus 1pt minus 0.5pt}%
  \fi\fi}{\par}

% ------------------------------------------------------- Fichas y notas ------
\newcommand{\circulofoto}[2]{% #1 imagen  #2 diámetro
  \begin{tikzpicture}[baseline={([yshift=-0.5ex]current bounding box.center)}]
    \begin{scope}
      \clip (0,0) circle (#2/2);
      \node[inner sep=0pt] at (0,0) {\includegraphics[width=#2]{#1}};
    \end{scope}
    \draw[filete, line width=0.6pt] (0,0) circle ({#2/2-0.3pt});
  \end{tikzpicture}%
}
\newlength{\diametrofoto}\setlength{\diametrofoto}{19mm}
\newcommand{\cabezaficha}[2]{%
  {\estilotitulos\fontsize{10.6}{12.8}\negrita\color{verdeoscuro}#1\par}%
  \ifblank{#2}{}{\vspace{0.6mm}{\estilotitulos\small\color{verdegris}#2\par}}}
% Ficha con foto circular: #1 imagen  #2 nombre  #3 detalle
\newcommand{\ficha}[3]{%
  \par\necesito{\dimexpr\diametrofoto+6\baselineskip\relax}\addvspace{4mm}%
  \noindent\begin{minipage}[c]{\diametrofoto}\circulofoto{#1}{\diametrofoto}\end{minipage}%
  \hspace{3.5mm}%
  \begin{minipage}[c]{\dimexpr\linewidth-\diametrofoto-3.5mm\relax}\cabezaficha{#2}{#3}\end{minipage}%
  \par\nopagebreak\vspace{2.6mm}%
}
% Ficha sin foto
\newcommand{\fichasola}[2]{%
  \par\necesito{6\baselineskip}\addvspace{4mm}%
  \cabezaficha{#1}{#2}\par\nopagebreak\vspace{1.8mm}%
}
% Compositor que ya apareció: nombre, datos y «Ver pág. N» (con enlace)
\newcommand{\fichaver}[3]{% #1 nombre  #2 detalle  #3 etiqueta de la semblanza
  \par\necesito{4\baselineskip}\addvspace{4mm}%
  {\estilotitulos\fontsize{10.6}{12.8}\negrita\color{verdeoscuro}#1\par}%
  \vspace{0.6mm}{\estilotitulos\small\color{verdegris}\ifblank{#2}{}{#2\enspace·\enspace}%
    \hyperref[#3]{\color{acento}\bfseries Ver pág.~\pageref*{#3}}\par}%
  \nopagebreak\vspace{1.4mm}%
}
\newcommand{\notaobra}[1]{%
  \par\necesito{7\baselineskip}\addvspace{3mm}%
  {\estilotitulos\bfseries\color{acento}#1\par}\nopagebreak\vspace{0.4mm}%
}
% ----------------------------------------------------------- Logotipos ------
% Franja de logotipos al pie de la última página de un concierto (en las
% actividades académicas, a continuación del texto). Llegan en un solo color
% (preparar_logos.py) y el filtro les da un tamaño visual parejo.
\newcommand{\logo}[3]{\raisebox{-0.5\height}{\includegraphics[width=#2,height=#3]{#1}}}
\newcommand{\logosep}{\hskip 5mm plus 4mm minus 1.5mm\relax}
\newcommand{\franjalogos}[1]{{\centering\setlength{\baselineskip}{10mm}%
  \setlength{\lineskiplimit}{1.5mm}\setlength{\lineskip}{3mm}#1\par}}
% #1 sección (para el ajuste fino)  #2 logotipos. La franja (filete y
% logotipos) va en una caja que no se parte; si no cabe, pasa entera a la
% página siguiente.
\newbox\cajalogos
\newcommand{\cajadelogos}[2][5mm]{\setbox\cajalogos=\vbox{\hsize=\linewidth
  \parindent=0pt\parskip=0pt{\color{filete}\hrule height 0.45pt}\vskip #1\franjalogos{#2}}}
\newcommand{\logosconcierto}[2]{\par
  \ifblank{#1}{\def\logosaqui{1}}{\directlua{fimnme.logosfin("#1")}}%
  \ifnum\logosaqui=1
    \cajadelogos{#2}%
    % si no cabe (también si la página ya está llena), a la página siguiente
    \ifdim\pagetotal>0pt
      \ifdim\dimexpr\pagegoal-\pagetotal\relax<\dimexpr\ht\cajalogos+\dp\cajalogos+6mm\relax
        \newpage\fi\fi
    \vspace*{\fill}\vskip 6mm\box\cajalogos
    \ifblank{#1}{}{\marcapos{logos:#1}}\par
  \fi}
% Alternativa: la franja al pie de la página del programa (cuando al final
% del concierto quedaría sola en una página). «fil» cede ante el \vspace*{\fill}
% que lleva al pie el bloque de intérpretes: la franja queda debajo de él.
\newcommand{\logosprograma}[3]{% #1 concierto  #2 fil/fill  #3 logotipos
  \directlua{fimnme.logosprograma(#1)}%
  \ifnum\logosaqui=1 \logosalpie[#2]{#3}\fi}
% Conciertos que solo tienen programa: la franja siempre al pie del programa
\newcommand{\logosalpie}[2][fill]{\par\vspace{0pt plus 1#1}\cajadelogos[3.5mm]{#2}%
  \vskip 3.5mm\box\cajalogos\par}
% Página final con todos los logotipos de los conciertos (antes del colofón)
\newcommand{\logosepancho}{\hskip 6mm plus 5mm minus 2mm\relax}
\newcommand{\paginalogos}[1]{\clearpage\thispagestyle{empty}\fijarcabecera{}%
  \vspace*{\fill}%
  {\centering{\estilotitulos\footnotesize\bfseries\color{verdegris}%
    \espaciado[120]{CON LA COLABORACIÓN DE}\par}\vspace{9mm}%
   \setlength{\baselineskip}{11mm}\setlength{\lineskiplimit}{2mm}%
   \setlength{\lineskip}{3.5mm}#1\par}%
  \vspace*{\fill}}
% Nota que ya apareció (misma obra, mismo texto): título y «Ver pág. N»
\newcommand{\notaver}[2]{% #1 título  #2 etiqueta de la nota
  \par\necesito{2\baselineskip}\addvspace{2.6mm}%
  {\estilotitulos\raggedright{\bfseries\color{acento}#1}\nobreak\enspace
    {\small\color{verdegris}·\enspace nota al programa:\enspace
    \hyperref[#2]{\color{acento}\bfseries Ver pág.~\pageref*{#2}}}\par}%
}
% Subtítulo dentro de una semblanza («Integrantes»...)
\newcommand{\subtitulosemblanza}[1]{\par\necesito{4\baselineskip}%
  \addvspace{0.3\baselineskip}{\bfseries #1\par}\nopagebreak}
\newcommand{\firma}[1]{\par\nopagebreak{\raggedleft\small\itshape\color{verdegris}#1\par}}
% Notas al programa: recuadro con fondo y filete verdes, al tamaño del texto.
% Las semblanzas, en cambio, van sin recuadro y un punto menos.
\newenvironment{notaobratexto}{%
  \par\nopagebreak
  \begin{tcolorbox}[enhanced, breakable, frame hidden, boxrule=0pt, sharp corners,
    colback=fondocita, borderline west={1.6pt}{0pt}{acentoclaro},
    left=3mm, right=2.4mm, top=1.8mm, bottom=1.8mm, before skip=0.6mm, after skip=2.2mm,
    parbox=false]
  \setparsizes{0pt}{0.5\baselineskip plus 1pt}{0pt plus 1fil}}
  {\end{tcolorbox}}
% Citas (dentro de una nota con otros párrafos): sangradas, con filete fino.
\newenvironment{cita}{%
  \par\addvspace{0.4\baselineskip}%
  \begin{tcolorbox}[enhanced, breakable, frame hidden, boxrule=0pt, sharp corners,
    opacityback=0, borderline west={0.6pt}{0pt}{acentoclaro},
    left=2.4mm, right=0mm, top=0mm, bottom=0mm, boxsep=0pt,
    before skip=0pt, after skip=0pt, parbox=false]
  \setparsizes{0pt}{0.5\baselineskip plus 1pt}{0pt plus 1fil}}
  {\end{tcolorbox}\par\addvspace{0.4\baselineskip}}
% Semblanzas: un punto menos que las notas al programa.
\newenvironment{semblanza}{\par\small
  \setparsizes{0pt}{0.5\baselineskip plus 1pt minus 0.5pt}{0pt plus 1fil}}{\par}
\renewenvironment{quote}{\begin{cita}}{\end{cita}}
\renewenvironment{quotation}{\begin{cita}}{\end{cita}}

% Actividades del Coloquio
\newcommand{\actividad}[2]{%
  \par\necesito{6\baselineskip}\addvspace{4mm}%
  {\estilotitulos\fontsize{8}{10}\bfseries\color{acento}\espaciado[40]{#1}\par}%
  \vspace{0.6mm}{\estilotitulos\fontsize{11}{13.4}\negrita #2\par}\nopagebreak\vspace{1mm}}

% Sedes, créditos, directorio
\newcommand{\entradasede}[2]{%
  \par\necesito{3\baselineskip}\addvspace{2.2mm}%
  {\estilotitulos\bfseries #1\par}\nopagebreak{\estilotitulos\small\color{verdegris}#2\par}}
\newcommand{\grupocreditos}[1]{%
  \par\necesito{4\baselineskip}\addvspace{5mm}%
  {\estilotitulos\fontsize{8.2}{10}\bfseries\color{acento}%
   \rule[-0.5mm]{2.2pt}{3.2mm}\hspace{1.8mm}\espaciado[70]{\MakeUppercase{#1}}\par}\nopagebreak\vspace{1mm}}
\makeatletter
\newcommand{\saltocredito}{\par\nobreak\vspace{-\parskip}\nobreak}
\makeatother
\newenvironment{creditos}{\par\centering\small
  \let\\\saltocredito % el cargo no se separa del nombre
  \setlength{\parskip}{2.4mm plus 0.5mm}\hyphenpenalty=10000
  \renewcommand{\grupocreditos}[1]{%
    \par\necesito{4\baselineskip}\addvspace{6mm}%
    {\fontsize{8.2}{10}\bfseries\color{acento}\espaciado[70]{\MakeUppercase{##1}}\par}%
    \nopagebreak\vspace{1.4mm}}%
  }{\par}
\newenvironment{colofon}{%
  \clearpage\thispagestyle{empty}\fijarcabecera{}%
  \vspace*{\fill}\begingroup\centering\footnotesize\color{verdegris}%
  \setlength{\parskip}{2.6mm}\hyphenpenalty=10000
  {\logofimnme{10mm}{verdegris}\par}\vspace{4mm}}
  {\par\endgroup\vspace*{\fill}}
\newcommand{\credito}[2]{% #1 nombre  #2 cargo
  \par\addvspace{1.6mm}{\estilotitulos\bfseries #1\par}%
  \ifblank{#2}{}{\nopagebreak{\estilotitulos\small\itshape\color{verdegris}#2\par}}}

% ======================================================================
%  Índice general
% ======================================================================
\makeatletter
\renewcommand*{\@pnumwidth}{2.2em}
\renewcommand*{\@tocrmarg}{3.4em}
\newcommand*{\l@parte}[2]{%
  \par\addvspace{5mm}\necesito{4\baselineskip}%
  {\estilotitulos\normalsize\negrita\color{verdeoscuro}%
   \leftskip=0pt\rightskip=\@tocrmarg\parfillskip=-\rightskip
   #1\nobreak\hfill\nobreak\hb@xt@\@pnumwidth{\hss\color{acento}#2}\par}%
  \nopagebreak\vspace{0.6mm}{\color{filete}\hrule height 0.5pt}\nopagebreak\vspace{1mm}}
\newcommand*{\l@dia}[2]{%
  \par\addvspace{2.2mm}\necesito{3\baselineskip}%
  {\estilotitulos\fontsize{7.8}{9.6}\bfseries\color{acento}\espaciado[50]{#1}\par}\nopagebreak[4]}
\newcommand*{\l@concierto}{\@dottedtocline{1}{0pt}{3.05em}}
\newcommand*{\l@seccionmayor}{\@dottedtocline{1}{0pt}{0pt}}
\renewcommand*{\@dotsep}{2.2}
\newcommand{\indicegeneral}{%
  \clearpage
  \fijarcabecera{Índice}%
  \phantomsection\marcador{0}{Índice}%
  {\fontsize{18}{22}\negrita\color{verdeoscuro}Índice\par}
  \vspace{2mm}%
  \begingroup
    \small\estilotitulos
    \setlength{\parskip}{0.9mm plus 0.2mm}%
    \let\numberline\@numberline@toc
    \@starttoc{toc}%
  \endgroup
}
\newcommand{\@numberline@toc}[1]{\hb@xt@\@tempdima{{\fuentecifras\bfseries\color{acento}#1}\hfil}}
\makeatother

% ======================================================================
%  Índice onomástico
% ======================================================================
\makeatletter
\renewenvironment{theindex}{%
  \clearpage
  \fijarcabecera{Índice onomástico}%
  \phantomsection\addcontentsline{toc}{seccionmayor}{Índice onomástico}%
  \marcador{0}{Índice onomástico}%
  {\fontsize{18}{22}\negrita\color{verdeoscuro}Índice onomástico\par}
  \vspace{1mm}{\small\color{verdegris}Personas compositoras cuyas obras se interpretan en el Foro.\par}
  \vspace{3mm}%
  \small\estilotitulos
  \setlength{\parskip}{0pt}%
  \let\item\@idxitem}
  {\par}
\renewcommand{\@idxitem}{\par\hangindent 1.5em\addvspace{0.7mm}}
\renewcommand{\indexspace}{\par\addvspace{3mm}}
\makeatother
\newcommand{\letraindice}[1]{%
  \par\necesito{4\baselineskip}\addvspace{2mm}%
  {\fontsize{9}{11}\negrita\color{acento}#1\par}\nopagebreak\vspace{0.6mm}}
\newcommand{\paginasindice}[1]{{\fuentecifras\color{verdegris}#1}}

% ======================================================================
\begin{document}
\pagenumbering{arabic}
\portada
\indicegeneral

$body$

\contraportada
\end{document}

% =============================================================================
%  Programa resumido del 48º FIMNME
%  Mismo formato (108 × 192 mm) y paleta que el Programa general. Todo en
%  Noto Sans (sin versiones condensadas): la agenda a dos columnas; los
%  programas a una columna, con cuerpo de lectura.
%  El contenido lo genera resumen/resumen.lua a partir del Markdown.
% =============================================================================
\documentclass[fontsize=8pt, parskip=false]{scrartcl}

\usepackage[
  paperwidth=108mm, paperheight=192mm,
  top=7mm, bottom=11mm, left=7mm, right=7mm, footskip=5.5mm
]{geometry}

% ----------------------------------------------------------- Tipografía ------
\usepackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\newcommand{\rutafuentes}{automatizacion/fuentes/}
\setmainfont{NotoSans}[
  Path=\rutafuentes, Extension=.ttf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic,
  FontFace={l}{n}{*-Light}, FontFace={l}{it}{*-LightItalic},
  Numbers=Lining
]
% El papel de un intérprete (el instrumento, «director»…), más ligero que el nombre
\newcommand{\papel}[1]{{\fontseries{l}\selectfont #1}}
\IfFontExistsTF{Noto Sans CJK SC}
  {\newfontfamily\fuentecjk{Noto Sans CJK SC}
   \newcommand{\textocjk}[1]{{\fontshape{n}\fuentecjk #1}}}
  {\newcommand{\textocjk}[1]{#1}}

\usepackage[spanish, es-nodecimaldot, es-noquoting, es-noshorthands, es-nolayout]{babel}
\usepackage[protrusion=true, expansion=true, tracking=true, final]{microtype}
\usepackage{ragged2e}
\usepackage{multicol}
\setlength{\columnsep}{4mm}
\setlength{\multicolsep}{0pt}
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\emergencystretch=1em
\setlength{\overfullrule}{0pt}

% ---------------------------------------------------------------- Color ------
\usepackage{xcolor}
\usepackage{luacolor}
\definecolor{verdeoscuro}{HTML}{172B20}
\definecolor{acento}{HTML}{2F7F59}
\definecolor{acentoclaro}{HTML}{3D9B6E}
\definecolor{verdeclaro}{HTML}{D2E8DB}
\definecolor{verdegris}{HTML}{546B5C}
\definecolor{filete}{HTML}{B9CDBF}
\definecolor{fondobeige}{HTML}{F4F1EA}
% Logotipo del Foro, siempre en el color de las postales del diseñador
\definecolor{colorlogo}{HTML}{E6AE78}
\pagecolor{fondobeige}
\color{verdeoscuro}

\usepackage{graphicx}
\usepackage{tikz}
\input{automatizacion/plantilla/logo-48.tex}
\input{automatizacion/plantilla/logo-cnmo.tex}

\usepackage[hidelinks, pdfusetitle]{hyperref}
\hypersetup{
  pdftitle={48º FIMNME · Programa resumido},
  pdfauthor={Coordinación Nacional de Música y Ópera},
  pdflang={es-MX}}

% ------------------------------------------------------- Pie de página -------
\usepackage[automark]{scrlayer-scrpage}
\clearpairofpagestyles
\setkomafont{pagefoot}{\fontsize{6.4}{7.5}\selectfont\color{verdegris}}
\ifoot{48º Foro Internacional de Música Nueva Manuel Enríquez · Programa resumido}
\ofoot{\thepage}
\pagestyle{scrheadings}

% ------------------------------------------------------- Piezas comunes ------
\newcommand{\espaciado}[2][70]{\textls[#1]{#2}}
% Clave de sede: letra blanca sobre verde
\setlength{\fboxsep}{0.5pt}
\newcommand{\letra}[1]{\ifx&#1&\else\kern0.2em{\colorbox{acento}{\makebox[1.25em]{%
  \fontsize{6.4}{6.4}\selectfont\bfseries\color{white}\strut#1}}}\fi}
\newcommand{\banda}[1]{\par\addvspace{3.2mm}%
  {\fontsize{7.6}{9}\selectfont\bfseries\color{acento}\espaciado{\MakeUppercase{#1}}\par}%
  \nopagebreak\vspace{0.7mm}{\color{filete}\hrule height 0.5pt}\nopagebreak\vspace{1.4mm}}

% ------------------------------------------------------------- Agenda --------
\newlength{\anchohora}\setlength{\anchohora}{3.25em}% «19 h», «19:30 h»
\newenvironment{agenda}{%
  \thispagestyle{empty}%
  \noindent\begin{minipage}[c]{10mm}\logofimnme{10mm}{colorlogo}\end{minipage}\hspace{3mm}%
  \begin{minipage}[c]{\dimexpr\linewidth-13mm\relax}\RaggedRight
    {\fontsize{9.6}{11.4}\selectfont\bfseries Foro Internacional de Música Nueva\\
      Manuel Enríquez\par}\vspace{0.8mm}
    {\fontsize{8}{9.6}\selectfont\color{acento}\bfseries 6 al 21 de noviembre de 2026
      \enspace·\enspace\color{verdegris}\mdseries Agenda y programas\par}
  \end{minipage}\par\vspace{1.8mm}%
  {\color{filete}\hrule height 0.6pt}\vspace{1mm}%
  {\fontsize{6.8}{8.2}\selectfont\color{verdegris}En cursiva, actividades académicas y
    sesiones del Coloquio Manuel Enríquez~100.\\
    La letra indica la sede (al final de la agenda, con su dirección).\par}\vspace{0.6mm}%
  \fontsize{7}{8.3}\selectfont
  \begin{multicols}{2}\raggedright
  \clubpenalty=10000 \widowpenalty=10000 \hyphenpenalty=10000 \exhyphenpenalty=10000
  \let\agendaparte\banda}
  {\end{multicols}\clearpage}
% El día, en su propio renglón (solo en la primera entrada de cada día)
\newcommand{\dia}[1]{\ifx&#1&\else\par\addvspace{1.15mm}%
  {\bfseries\color{acento}\espaciado[40]{#1}\par}\nopagebreak\vspace{0.2mm}\fi}
% #1 día  #2 hora  #3 título  #4 letra de la sede
\newcommand{\ev}[4]{\dia{#1}\par
  \hangindent=\anchohora\hangafter=1
  \makebox[\anchohora][l]{#2}#3\nobreak\hskip 0.5em plus 1fill\letra{#4}\par}
% Actividad académica o del Coloquio (en cursiva)
\newcommand{\act}[4]{\dia{#1}\par
  \hangindent=\anchohora\hangafter=1
  \makebox[\anchohora][l]{\color{verdegris}#2}%
  {\itshape\color{verdegris}#3}\nobreak\hskip 0.5em plus 1fill\letra{#4}\par}
\newcommand{\region}[1]{\par\addvspace{1mm}%
  {\bfseries\color{verdegris}\espaciado[50]{#1}\par}\nopagebreak\vspace{0.4mm}}
% #1 letra  #2 sala y sede  #3 dirección
\newcommand{\sede}[3]{\par\addvspace{0.35mm}%
  {\fontsize{7}{8.3}\selectfont\hangindent=1.75em\hangafter=1
  \makebox[1.75em][l]{\letra{#1}}{\bfseries #2}\ifx&#3&\else.
  {\color{verdegris}#3}\fi\par}}

% ----------------------------------------------------------- Programas -------
% Cada concierto (y cada actividad) se compone en una caja: no se parte
% entre páginas.
\newlength{\sangria}\setlength{\sangria}{1em}
\newbox\cajaconcierto
% #1 total de estrenos del Foro
\newenvironment{programas}[1]{%
  \fontsize{8}{10.2}\selectfont\raggedright
  \clubpenalty=10000 \widowpenalty=10000 \hyphenpenalty=10000 \exhyphenpenalty=10000
  {\fontsize{10}{11.8}\selectfont\bfseries Programas\par}\vspace{1mm}%
  {\color{verdegris}\fontsize{7.2}{8.8}\selectfont Por concierto: intérpretes y personas
   compositoras. La letra remite a la sede (pág.~\pageref{sedes}).%
   \ifx&#1&\else\ En total, el Foro presenta #1.\fi\par}%
  \let\programaparte\banda}
  {\par}
% Cierre: logotipo de la CNMO y remisión al Programa general
\newcommand{\cierre}{\par\vspace{4mm}{\color{filete}\hrule height 0.5pt}\vspace{2.2mm}%
  \noindent\begin{minipage}[c]{8mm}\logocnmo{8mm}{verdegris}\end{minipage}\hspace{2.5mm}%
  \begin{minipage}[c]{\dimexpr\linewidth-10.5mm\relax}\RaggedRight
    \color{verdegris}\fontsize{7}{8.6}\selectfont Obras, semblanzas y notas al programa
    en el \mbox{Programa general} del \mbox{48º FIMNME}.\end{minipage}\par}
% #1 fecha y hora  #2 letras de sede  #3 título  #4 sede
\newcommand{\concierto}[4]{\par\addvspace{3.4mm}%
  \setbox\cajaconcierto=\vbox\bgroup
  {\fontsize{7.2}{8.8}\selectfont\bfseries\color{acento}\espaciado[30]{#1}}\nobreak\hfill#2\par
  \vspace{0.3mm}%
  {\fontsize{9.6}{11.4}\selectfont\bfseries #3\par}%
  \ifx&#4&\else{\fontsize{7.2}{8.8}\selectfont\color{verdegris}#4\par}\fi
  \vspace{0.8mm}}
\newcommand{\finconcierto}{\par\egroup\box\cajaconcierto\relax}
% Un grupo de obras: #1 intérpretes  #2 «Obras de…»
\newcommand{\grupo}[2]{\par\addvspace{0.9mm}%
  \ifx&#1&\else
    \hangindent=\sangria\hangafter=1
    \makebox[\sangria][l]{\color{acentoclaro}\rule[-0.3ex]{1pt}{2ex}}#1\par
  \fi
  \ifx&#2&\else{\leftskip=\sangria\relax#2\par}\fi}
\newcommand{\estrenos}[1]{\par\vspace{0.6mm}%
  {\leftskip=\sangria\relax\fontsize{7.2}{8.8}\selectfont\itshape\color{acento}#1\par}}
% Actividad académica o sesión del Coloquio: #1 fecha  #2 sede  #3 título  #4 participantes
\newcommand{\actividad}[4]{\par\addvspace{2mm}%
  \setbox\cajaconcierto=\vbox{%
  {\fontsize{7.2}{8.8}\selectfont\bfseries\color{acento}\espaciado[30]{#1}}\nobreak\hfill#2\par
  {\fontsize{8.6}{10.4}\selectfont\bfseries #3\par}%
  \ifx&#4&\else\vspace{0.3mm}{\fontsize{7.4}{9}\selectfont\color{verdegris}#4\par}\fi}%
  \box\cajaconcierto\relax}

% ------------------------------------------------------ Logotipos (final) ----
% Todos los logotipos del Programa general, en una página, como allá.
\newcommand{\logo}[3]{\raisebox{-0.5\height}{\includegraphics[width=#2,height=#3]{#1}}}
\newcommand{\logosep}{\hskip 5mm plus 5mm minus 2mm\relax}
\newcommand{\paginalogos}[1]{\clearpage\thispagestyle{empty}
  \vspace*{\fill}%
  {\centering{\fontsize{7.6}{9}\selectfont\bfseries\color{verdegris}%
    \espaciado[120]{CON LA COLABORACIÓN DE}\par}\vspace{2mm}%
   \setlength{\baselineskip}{11mm}\setlength{\lineskiplimit}{2mm}%
   \setlength{\lineskip}{3.5mm}#1\par}%
  \vspace*{\fill}\cierre}

% ---------------------------------------------------- Contraportada ------
% Directorio de la Secretaría de Cultura y del INBAL, y la pleca al pie
\makeatletter
\newcommand{\saltodirectorio}{\par\nobreak\vspace{-\parskip}\nobreak}
\makeatother
\newcommand{\grupodirectorio}[1]{\par\addvspace{5mm}%
  {\fontsize{7.4}{9}\selectfont\bfseries\color{acento}\espaciado[80]{\MakeUppercase{#1}}\par}%
  \nopagebreak\vspace{0.6mm}}
% Créditos del FIMNME y de la Coordinación Nacional de Música y Ópera (los del
% Programa general), antes del directorio de la última página
\newcommand{\creditos}[1]{\clearpage\thispagestyle{empty}%
  \vspace*{\fill}%
  {\centering\fontsize{7.6}{9.2}\selectfont\let\\\saltodirectorio
   \setlength{\parskip}{1.8mm}\hyphenpenalty=10000 #1\par}%
  \vspace*{\fill}}
\newcommand{\contraportada}[1]{\clearpage\thispagestyle{empty}%
  \vspace*{\fill}%
  {\centering\fontsize{8}{9.8}\selectfont\let\\\saltodirectorio
   \setlength{\parskip}{2.2mm}\hyphenpenalty=10000 #1\par}%
  \vspace{8mm}{\centering\logocnmo{8mm}{verdegris}\par}%
  \vspace*{\fill}\vspace*{22mm}%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south, inner sep=0pt] at (current page.south)
      {\includegraphics[width=\paperwidth]{build/resumen/pleca.png}};
  \end{tikzpicture}}

\begin{document}
$body$
